"""Bazel module definition for rules_motoko."""

module(
    name = "rules_motoko",
    version = "1.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Create and map the Motoko toolchain repo for this ruleset so labels
# like @motoko_toolchain resolve when consumed via bzlmod.
motoko = use_extension("//motoko:extensions.bzl", "motoko")
motoko.toolchain(version = "0.16.3")
use_repo(motoko, "motoko_toolchain")
